<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.ArcView">

        <!-- 锁竖屏，这是有意的：不锁的话手机平放往下拍时系统会自己转，
             叠加层跟着翻，实测「往下拍拍不了」。
             ⚠ 代价：MainActivity 里那套横屏分支（onConfigurationChanged 设
             targetRotation、adjustPanelHeight 的 landscape 系数）永远不可达。
             要支持横构图的话，正确做法是这里改成 fullSensor 并且把
             updatePreviewAspect 里基于 display.rotation 的四个分支测一遍，
             不是把锁去掉就完事。 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <!-- 网页版的壳。**现在是启动页** —— 这个 APK 就是"网页端 + 自动记录"。
             ⚠ 必须锁竖屏，跟 MainActivity 同一个理由（上面那段注释）。
             第一次给这里设了 fullSensor 想让系统去转 —— 结果是**转了两次**：
             系统把整个 View 转了 90°，页面自己那套软件转屏（syncTurn）又转 90°，
             实测"UI 是正的、取景区域整个翻了"。
             锁住之后系统永不转，屏幕朝向恒定竖屏，软件转屏那一套才有确定的输入。 -->
        <activity
            android:name=".WebActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
